# Build output
/strata
/strata-*
*.test

# Local demo state
/tmp/
*.log

# macOS
.DS_Store

# Credentials and secrets.
#
# These are belt and braces, not the defence. Credentials belong outside the
# repository entirely, because .gitignore does nothing for a file that is
# already tracked, and nothing at all for a value pasted into a commit message
# or a chat. See the pre-commit hook for the case these patterns miss.
.env
.env.*
*.env
.envrc
secrets/
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials
.aws/

# Subagent worktrees. The harness creates these under .claude/worktrees/ when a
# worktree-isolated agent runs, and removes them again -- but while one exists
# it shows up as untracked here, one `git add -A` away from being committed
# into the repository it is a checkout of.
.claude/worktrees/
